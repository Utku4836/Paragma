#!/usr/bin/env node
// Runs the native pg binary. npm installs it from the platform package that
// matches this machine (paragma-<platform>-<arch>, an optional dependency),
// so the install needs no download script.
const { spawnSync } = require("child_process");
const fs = require("fs");
const path = require("path");

const pkg = `paragma-${process.platform}-${process.arch}`;
const name = process.platform === "win32" ? "pg.exe" : "pg";
let exe;
try {
  exe = path.join(path.dirname(require.resolve(`${pkg}/package.json`)), "bin", name);
} catch {
  console.error(`paragma: ${pkg} is not installed (no prebuilt pg for this platform, or optional dependencies were skipped).`);
  console.error("Reinstall with: npm install -g paragma --include=optional");
  console.error("or download pg from https://github.com/Utku4836/Paragma/releases");
  process.exit(7);
}
if (process.platform !== "win32") {
  try {
    fs.accessSync(exe, fs.constants.X_OK);
  } catch {
    try { fs.chmodSync(exe, 0o755); } catch {}
  }
}
const r = spawnSync(exe, process.argv.slice(2), { stdio: "inherit" });
if (r.error) {
  console.error("paragma: " + r.error.message);
  process.exit(7);
}
if (r.signal) {
  process.kill(process.pid, r.signal);
}
process.exit(r.status === null ? 1 : r.status);
