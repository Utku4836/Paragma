#!/usr/bin/env node
// Runs the native pg binary for this computer, downloading it first when
// the install did not (install scripts turned off, or no network then).
"use strict";
const { spawnSync } = require("child_process");
const fs = require("fs");
const { install, binaryPath } = require("../install.js");

async function main() {
  let exe = binaryPath();
  if (!exe) {
    console.error(`paragma: no prebuilt pg for ${process.platform}/${process.arch}.`);
    console.error("Build it from source: https://github.com/Utku4836/Paragma");
    process.exit(7);
  }
  if (!fs.existsSync(exe)) {
    try {
      exe = await install();
    } catch (e) {
      console.error(`paragma: ${e.message}`);
      console.error("Download pg by hand from https://github.com/Utku4836/Paragma/releases");
      process.exit(7);
    }
  }
  const r = spawnSync(exe, process.argv.slice(2), { stdio: "inherit" });
  if (r.error) {
    console.error("paragma: " + r.error.message);
    process.exit(7);
  }
  if (r.signal) {
    process.kill(process.pid, r.signal);
  }
  process.exit(r.status === null ? 1 : r.status);
}

main();
